{
  "name": "backuphub",
  "version": "0.1.0",
  "description": "BackupHub — scheduled backups for databases, AWS S3, and server files",
  "main": "./out/main/index.js",
  "author": "BackupHub",
  "homepage": "https://github.com/taamsamane/backup.pack",
  "license": "MIT",
  "desktopName": "BackupHub.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:ci": "echo 'Use GitHub Actions (.github/workflows/release.yml) — native modules cannot be cross-compiled'",
    "start": "electron-vite preview",
    "fix-chrome-sandbox": "echo 'Run: sudo chown root:root node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 node_modules/electron/dist/chrome-sandbox'",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/credential-providers": "^3.1154.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "archiver": "^8.0.0",
    "basic-ftp": "^6.2.3",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.10",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "tar": "^7.5.22",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "drizzle-kit": "^0.31.8",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "uuid": "^14.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
